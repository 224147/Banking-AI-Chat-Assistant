# --- App ---
APP_NAME=Banking AI Chat Assistant
ENVIRONMENT=development
DEBUG=true

# --- LLM ---
LLM_PROVIDER=mock          # mock | openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30

# --- RAG ---
EMBEDDING_MODEL=local-hash # local-hash | openai
SIMILARITY_THRESHOLD=0.25
TOP_K=4
CHROMA_PERSIST_DIR=./data/chroma

# --- Event Bus ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=banking.events

# --- Database ---
DATABASE_URL=postgresql+asyncpg://banking:banking@localhost:5432/banking_chat

# --- Security ---
SESSION_SECRET_KEY=change-me-in-production
IDEMPOTENCY_TTL_SECONDS=86400

# --- Observability ---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=banking-chat-assistant
OTEL_EXPORTER_ENDPOINT=
